# =============================================================================
# Sairash BI — Backend Environment (FastAPI)
# Copy to .env and fill. NEVER commit real secrets.
# See docs: `python -c "from app.core.config import get_settings; print(get_settings().masked_summary())"`
# =============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────
# dev = lax validation, prod = strict (fails on weak secrets)
ENV=dev

# ── Database ───────────────────────────────────────────────────────────────
# Postgres DSN. Use Supabase or a local Postgres.
# Example local:  postgresql+asyncpg://postgres:postgres@localhost:5432/bi_dev
# Example Supabase: postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/bi_dev

# ── Supabase / Auth ───────────────────────────────────────────────────────
# Get these from https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# HS256 secret for JWT mint & verify — MUST be >=32 chars, random.
# Generate: openssl rand -hex 32
SUPABASE_JWT_SECRET=change-me-use-openssl-rand-hex-32
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# JWT
JWT_AUDIENCE=authenticated
JWT_EXPIRY_HOURS=24            # auth token TTL (prod: 24h, dev: longer ok)
JWT_RESET_EXPIRY_MINUTES=30    # password-reset token TTL

# ── AWS / Storage ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
S3_BUCKET=bi-fyp-dev-uploads
# When AWS creds are absent, uploads fall back to local disk (var/uploads).

# ── Frontend / CORS ───────────────────────────────────────────────────────
# Comma-separated allowlist — no wildcards. First entry is also FRONTEND_URL.
FRONTEND_ORIGINS=http://localhost:3000

# ── Google OAuth (optional) ───────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Add Authorised redirect: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Seed / Bootstrap ──────────────────────────────────────────────────────
# Platform operators (System Admins). Comma-separated; every address here is
# promoted to admin + super_admin on sign-in, by password or by Google.
ADMIN_EMAIL=admin@example.com
# Min 12 chars in prod. Never use a default in production.
ADMIN_PASSWORD=change-me-min-12-chars

# ── AI / LLM Providers (optional) ─────────────────────────────────────────
# Groq primary, Gemini fallback. Leave empty to use local deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Email / SMTP (optional) ───────────────────────────────────────────────
# Empty SMTP_HOST disables outbound email (in-app notifications still work).
# For local dev, run Mailpit:  docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=
SMTP_PORT=587                 # 587 = STARTTLS, 465 = SSL, 25 = plain
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sairash BI <alerts@sairash.local>
SMTP_TIMEOUT=15
SMTP_MAX_RETRIES=2
EMAIL_RATE_LIMIT_PER_MINUTE=10  # per-recipient throttle

# ── Security / Rate limiting ──────────────────────────────────────────────
# Per-key (token/IP) window. Strict paths (uploads, retrain, report generate) use 20/min.
RATE_LIMIT_PER_MINUTE=240
