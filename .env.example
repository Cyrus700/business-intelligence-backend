ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/bi_dev
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=dev-secret-do-not-use-in-production
SUPABASE_SERVICE_KEY=<service-key>
SUPABASE_ANON_KEY=<anon-key>
AWS_REGION=ap-south-1
S3_BUCKET=bi-fyp-dev-uploads
FRONTEND_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=50000
# ── AI / LLM Providers ────────────────────────────────────────────
# Groq (primary) — get a free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (fallback) — get a free API key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Google OAuth ───────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/apis/credentials
# then add "http://localhost:8000/api/v1/auth/google/callback" as
# an Authorised Redirect URI.
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<change-me>